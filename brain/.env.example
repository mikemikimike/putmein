# ==============================================================================
# Brain (AI Agent Engine) Environment Configuration
# ==============================================================================

# Port configuration
BRAIN_PORT=4500

# Inter-service URLs
RAY_URL="http://localhost:4567"

# Inter-service communication secret between Ray and Brain
BRAIN_INTERNAL_SECRET="putmein-sec-your-random-token-here"

# Agent filesystem restriction (leave empty for full access with prompts)
AGENT_ROOT=""

# Autonomous DevOps mode (true | false)
AGENT_AUTONOMOUS=false

