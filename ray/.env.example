# ==============================================================================
# Ray (Web Dashboard) Environment Configuration
# ==============================================================================

# Database Connection String (MySQL 8.0+)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/putmein?allowPublicKeyRetrieval=true"

# Cryptographically secure secret for JWT session signing (minimum 32 characters)
JWT_SECRET="generate-a-secure-random-32-byte-hex-secret"

# Application Name
NEXT_PUBLIC_APP_NAME="ray"

# Brain Shared AI Backend
BRAIN_URL="http://localhost:4500"
NEXT_PUBLIC_BRAIN_URL="http://localhost:4500"

# Inter-service RPC Secret
BRAIN_INTERNAL_SECRET="putmein-sec-your-random-token-here"

# Optional LLM API Keys (can also be configured via Settings UI)
# ANTHROPIC_API_KEY=""
# MINIMAX_API_KEY=""
# OPENROUTER_API_KEY=""

# Maximum deployment archive upload size in megabytes (defaults to 500 MB)
MAX_UPLOAD_SIZE_MB=500
