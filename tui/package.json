{
  "name": "putdev-tui",
  "version": "1.0.0",
  "description": "PutDev TUI - Go/Charm edition. DevOps is not a joke. Powered by Ozias.",
  "scripts": {
    "prebuild": "mkdir -p bin",
    "build": "/opt/homebrew/bin/go build -o bin/putdev .",
